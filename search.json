---
layout: null
sitemap: false
---
{% assign pub_posts = site.posts | where_exp: "p", "p.published != false" %}
[
{% for post in pub_posts %}
  {% assign cat_obj = site.data.categories | where: "slug", post.category | first %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "description": {{ post.description | jsonify }},
    "category": {{ post.category | jsonify }},
    "category_name": {{ cat_obj.name | default: post.category | jsonify }},
    "date": {{ post.date | date: "%b %-d, %Y" | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
